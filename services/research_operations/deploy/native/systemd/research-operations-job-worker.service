[Unit]
Description=Research Operations admitted research job worker
Documentation=file:/opt/research-platform/current/services/research_operations/deploy/native/README.md
Requires=research-operations-preflight.service research-operations-migrate.service
After=research-operations-preflight.service research-operations-migrate.service
PartOf=research-operations.target
StartLimitIntervalSec=180
StartLimitBurst=5

[Service]
Type=simple
User=research-job
Group=research-ops
WorkingDirectory=/opt/research-platform/current
EnvironmentFile=/etc/research-ops/runtime.env
Environment=RESEARCH_OPS_DATABASE_ROLE=runtime
Environment=POSTGRES_RUNTIME_PASSWORD_FILE=%d/postgres-runtime-password
Environment=DJANGO_SECRET_KEY_FILE=%d/django-secret-key
Environment=MARKET_RESEARCH_ATOMIC_PUBLICATION_MODE=0640
Environment=PATH=/opt/research-platform/current/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LoadCredential=postgres-runtime-password:/etc/research-ops/secrets/postgres-runtime-password
LoadCredential=django-secret-key:/etc/research-ops/secrets/django-secret-key
LoadCredential=operated-execution.key:/etc/research-ops/secrets/operated-execution.key
ExecStart=/usr/bin/env /opt/research-platform/current/services/research_operations/scripts/runtime-entrypoint.py /opt/research-platform/current/.venv/bin/research-ops research-job-worker --worker-id research-job:systemd-1 --poll-interval 1 --admission-lease-seconds 60
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=135s
TimeoutStopFailureMode=kill
OOMPolicy=stop
UMask=0027
RuntimeDirectory=research-operations-job-worker
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
InaccessiblePaths=/etc/research-ops/secrets
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/srv/research/data
ReadWritePaths=/srv/research/artifacts /srv/research/reports /srv/research/cache /srv/research/registry
ReadOnlyPaths=/srv/research/artifacts/_internal_web
ReadOnlyPaths=/srv/research/artifacts/reports/research/_registry
ReadOnlyPaths=/srv/research/artifacts/derived/research/projects
ReadOnlyPaths=/srv/research/reports/_internal_web
ReadOnlyPaths=/srv/research/cache/research/projects
TasksMax=128
LimitNOFILE=8192
MemoryMax=4G
CPUQuota=400%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=research-operations-job-worker
