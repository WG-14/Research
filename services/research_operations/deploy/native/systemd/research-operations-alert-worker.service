[Unit]
Description=Research Operations persistent service-health alert worker
Documentation=file:/opt/research-platform/current/services/research_operations/deploy/native/README.md
Requires=research-operations-preflight.service
After=research-operations-preflight.service
PartOf=research-operations.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=research-alert
Group=research-ops
WorkingDirectory=/opt/research-platform/current
EnvironmentFile=/etc/research-ops/runtime.env
Environment=RESEARCH_OPS_DATABASE_ROLE=runtime
Environment=POSTGRES_RUNTIME_PASSWORD_FILE=%d/postgres-runtime-password
Environment=DJANGO_SECRET_KEY_FILE=
Environment=RESEARCH_OPS_ALERT_ENDPOINT_URL_FILE=%d/service-alert-endpoint-url
Environment=PATH=/opt/research-platform/current/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LoadCredential=postgres-runtime-password:/etc/research-ops/secrets/postgres-runtime-password
LoadCredential=service-alert-endpoint-url:/etc/research-ops/secrets/service-alert-endpoint-url
ExecStart=/usr/bin/env /opt/research-platform/current/services/research_operations/scripts/runtime-entrypoint.py /opt/research-platform/current/.venv/bin/research-ops alert-worker
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45s
TimeoutStopFailureMode=kill
OOMPolicy=stop
UMask=0077
RuntimeDirectory=research-operations-alert-worker
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
InaccessiblePaths=/etc/research-ops/secrets
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/srv/research/data /srv/research/artifacts /srv/research/reports /srv/research/cache /srv/research/registry
TasksMax=48
LimitNOFILE=4096
MemoryMax=512M
CPUQuota=100%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=research-operations-alert-worker
