# All research inputs and outputs must be absolute paths outside this repository.
RESEARCH_DATA_ROOT=/var/lib/market-research/datasets
RESEARCH_ARTIFACT_ROOT=/var/lib/market-research/artifacts
RESEARCH_REPORT_ROOT=/var/lib/market-research/reports
RESEARCH_CACHE_ROOT=/var/lib/market-research/cache
RESEARCH_EXPERIMENT_IDENTITY_REGISTRY_PATH=/var/lib/market-research/_registry/research_validate_experiment_identity.jsonl
RESEARCH_FINAL_HOLDOUT_REGISTRY_PATH=/var/lib/market-research/_holdout_authority/final_holdout_authority.jsonl
RESEARCH_INDEPENDENT_VERIFIER_TRUST_STORE_PATH=/etc/research-ops/independent-verifier-trust.json
# Required only by the operated profile. Pin the exact canonical JSON bytes;
# neither a research manifest nor a CLI caller may substitute this digest.
RESEARCH_INDEPENDENT_VERIFIER_TRUST_STORE_HASH=sha256:REPLACE_64_HEX
# These are intentionally unset for local research. Dataset publication is an
# operated data-administration action; its trust store must be root-owned and
# preflight-attested rather than selected by a workstation caller.
RESEARCH_DATASET_TRANSFORMATION_TRUST_STORE_PATH=
RESEARCH_DATASET_TRANSFORMATION_TRUST_STORE_HASH=
RESEARCH_DB_PATH=/var/lib/market-research/candles.sqlite

# Optional deterministic execution controls.
RESEARCH_MAX_WORKERS=1
RESEARCH_RANDOM_SEED=0
